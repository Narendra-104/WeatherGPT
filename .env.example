# Environment Variables Template for WeatherGPT
# Copy this file to .env and populate the actual secrets.
# NEVER commit the actual .env file with secrets into version control.

# -----------------------------------------------------------------------------
# General Backend Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=WeatherGPT
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://weathergpt-ai-vert.vercel.app

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./weathergpt.db

# -----------------------------------------------------------------------------
# Weather Data Provider Configuration
# -----------------------------------------------------------------------------
# Supported primary providers: 'open_meteo' (no key required) or 'openweather'
WEATHER_PROVIDER=open_meteo

# OpenWeather API Configuration (required if WEATHER_PROVIDER=openweather)
WEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# Open-Meteo Configuration
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# Cache expiration in seconds for weather queries (default: 900 seconds / 15 minutes)
WEATHER_CACHE_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Multilingual AI Assistant Configuration
# -----------------------------------------------------------------------------
# AI Provider: mock, gemini, or openai
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Supported languages: en (English), hi (Hindi), mr (Marathi)
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,mr

# -----------------------------------------------------------------------------
# Frontend Configuration (for website .env.local)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LANGUAGE=en
